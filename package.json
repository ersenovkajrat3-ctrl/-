{
  "name": "volleyball-manager",
  "version": "1.0.0",
  "description": "Volleyball Manager — мобильный менеджер волейбольного клуба",
  "private": true,
  "scripts": {
    "serve": "python3 -m http.server 8899",
    "sim": "node tools/simtest.js",
    "season": "node tools/season-test.js",
    "e2e": "node tools/e2e.js",
    "e2e:season": "node tools/e2e-season.js",
    "e2e:save": "node tools/e2e-save.js",
    "e2e:late": "node tools/e2e-late.js",
    "e2e:press": "node tools/e2e-press.js",
    "e2e:weather": "node tools/e2e-weather.js",
    "e2e:found": "node tools/e2e-found.js",
    "e2e:arena": "node tools/e2e-arena.js",
    "e2e:euro": "node tools/e2e-euro.js",
    "build": "node tools/build-single.js",
    "icons": "node tools/make-icons.js",
    "www": "node tools/build-www.js",
    "android:brand": "node tools/android-brand.js",
    "android:sync": "node tools/build-www.js && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "playwright": "^1.49.1"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.1",
    "@capacitor/android": "^6.2.1"
  }
}
